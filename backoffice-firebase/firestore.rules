rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function hasBackOffice() {
      return signedIn() && request.auth.token.backoffice_access == true;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role == 'admin';
    }

    function tier() {
      return signedIn() && request.auth.token.tier is int ? request.auth.token.tier : 0;
    }

    match /contentUnits/{id} {
      allow read: if hasBackOffice() && resource.data.published == true && resource.data.tierMin <= tier();
      allow create, update, delete: if isAdmin();
    }

    match /nav/{id} {
      allow read: if hasBackOffice() && resource.data.published == true && resource.data.tierMin <= tier();
      allow create, update, delete: if isAdmin();
    }

    match /progress/{userId}/items/{contentId} {
      allow read: if hasBackOffice() && request.auth.uid == userId;
      allow create, update: if hasBackOffice() && request.auth.uid == userId;
      allow delete: if false;
    }
  }
}
